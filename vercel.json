{
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "outputDirectory": "dist",
    "framework": "vite",
    "cleanUrls": true,
    "routes": [
        {
            "src": "/images/(.+)",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/cv/(.+)",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/assets/(.+)",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        }
    ]
}
