{
    "version": 2,
    "outputDirectory": "public",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "rewrites": [
        {
            "source": "/((?!build/|images/|cv/|favicon\\.ico|robots\\.txt).*)",
            "destination": "/api/index.php"
        }
    ]
}
