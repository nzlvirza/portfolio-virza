{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "outputDirectory": "public",
    "buildCommand": "npm run build",

    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },

    "routes": [
        {
            "src": "/(build|images|cv|css|js|fonts|favicon)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)\\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|txt)$",
            "dest": "/public/$1.$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}