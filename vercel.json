{
    "version": 2,
    "outputDirectory": "public",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)"
        },
        {
            "src": "/images/(.*)"
        },
        {
            "src": "/cv/(.*)"
        },
        {
            "src": "/favicon.ico"
        },
        {
            "src": "/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
